# MTG Deal Sniper 2.2 – lokale Konfiguration
# Kopiere diese Datei nach ".env" und trage nur ein, was du brauchst.
# .env enthält Zugangsdaten und gehört NIE in ein Repository oder an Dritte.

# --- Server ---
# MTGDS_PORT=8787
# MTGDS_DATA_DIR=C:\Users\<name>\mtg-deal-sniper\data
# Automatischen Import ausschalten (z. B. für Tests):
# MTGDS_SCHEDULER=off

# --- Telegram (optional) ---
# Bot über @BotFather anlegen, Token hier eintragen. Chat-ID: dem Bot schreiben, dann
# https://api.telegram.org/bot<TOKEN>/getUpdates aufrufen und "chat":{"id":...} ablesen.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Discord (optional) ---
# Servereinstellungen → Integrationen → Webhooks → Webhook-URL kopieren.
# DISCORD_WEBHOOK_URL=

# --- Live-Deal-Radar (optional) ---
# Eigenes CardTrader-API-Token (CardTrader → Profil → Einstellungen → API). NUR dein eigenes Token, nie ein fremdes.
# Zusätzlich in den Einstellungen "CardTrader-Feed aktivieren" und – nach dem Lesen der API-Bedingungen –
# "Bedingungen gelesen" setzen. Ohne beides bleibt der Feed aus.
# CARDTRADER_TOKEN=

# Nur zum Testen: simulierter Listing-Feed (alle Ergebnisse SIMULATION/TEST, nie extern versendet).
# Am besten mit eigenem Datenordner, damit keine Testangebote in der echten Datenbank landen:
# MTGDS_MOCK_FEED=1
# MTGDS_DATA_DIR=C:\Users\<name>\mtg-deal-sniper\data-test
